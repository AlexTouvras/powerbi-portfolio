table DimPathwayNetwork

	measure 'Pathway cut points' =
			CONCATENATEX(
				FILTER(DimPathwayNetwork, DimPathwayNetwork[IsCutPointFlow] = 1),
				DimPathwayNetwork[Node],
				", "
			)

	column Node
		dataType: string
		summarizeBy: none
		sourceColumn: Node
		sortByColumn: FlowRank

	column FlowBetweenness
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: FlowBetweenness

	column FlowRank
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: FlowRank

	column IsCutPointFlow
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: IsCutPointFlow

	partition DimPathwayNetwork = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(GoldDataFolder & "/DimPathwayNetwork.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"Node", type text}, {"FlowBetweenness", type number}, {"FlowRank", Int64.Type}, {"IsCutPointFlow", Int64.Type}})
			in
				#"Changed Type"
