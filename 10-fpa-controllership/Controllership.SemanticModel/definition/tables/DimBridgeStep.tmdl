table DimBridgeStep

	column BridgeStep
		dataType: string
		sortByColumn: BridgeOrder
		summarizeBy: none
		sourceColumn: BridgeStep

	column BridgeOrder
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: BridgeOrder

	column IsTotal
		dataType: boolean
		summarizeBy: none
		sourceColumn: IsTotal

	column AccountID
		dataType: string
		summarizeBy: none
		sourceColumn: AccountID

	partition DimBridgeStep = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(GoldDataFolder & "/DimBridgeStep.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"BridgeStep", type text}, {"BridgeOrder", Int64.Type}, {"IsTotal", type logical}, {"AccountID", type text}})
			in
				#"Changed Type"
