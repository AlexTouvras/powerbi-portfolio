table DimAccount

	column AccountID
		dataType: string
		summarizeBy: none
		sourceColumn: AccountID

	column AccountName
		dataType: string
		sourceColumn: AccountName

	column Level
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Level

	column Operator
		dataType: string
		sourceColumn: Operator

	column Sign
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Sign

	column ParentID
		dataType: string
		sourceColumn: ParentID

	column SortOrder
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: SortOrder

	column Section
		dataType: string
		sourceColumn: Section

	column StatementLabel
		dataType: string
		sortByColumn: SortOrder
		sourceColumn: StatementLabel


	partition DimAccount = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(GoldDataFolder & "/DimAccount.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"AccountID", type text}, {"AccountName", type text}, {"Level", Int64.Type}, {"Operator", type text}, {"Sign", Int64.Type}, {"ParentID", type text}, {"SortOrder", Int64.Type}, {"Section", type text}, {"StatementLabel", type text}})
			in
				#"Changed Type"
