table FactScenario

	measure 'Sum Scenario OP' = SUM(FactScenario[OperatingProfitEur])
		formatString: #,0.0

	measure 'Scenario OP Base' = CALCULATE([Sum Scenario OP], FactScenario[Scenario] = "Base (actual)")
		formatString: #,0.0

	measure 'Scenario OP Revenue Up' = CALCULATE([Sum Scenario OP], FactScenario[Scenario] = "Revenue +5%")
		formatString: #,0.0

	measure 'Scenario OP FX Hit' = CALCULATE([Sum Scenario OP], FactScenario[Scenario] = "FX -3% hit")
		formatString: #,0.0

	measure 'Scenario Delta Revenue Up' = [Scenario OP Revenue Up] - [Scenario OP Base]
		formatString: #,0.0;#,0.0;0

	measure 'Scenario Delta FX Hit' = [Scenario OP FX Hit] - [Scenario OP Base]
		formatString: #,0.0;#,0.0;0

	column YearMonth
		dataType: string
		summarizeBy: none
		sourceColumn: YearMonth

	column Scenario
		dataType: string
		sourceColumn: Scenario

	column OperatingProfitEur
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: OperatingProfitEur


	partition FactScenario = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(GoldDataFolder & "/FactScenario.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"YearMonth", type text}, {"Scenario", type text}, {"OperatingProfitEur", type number}})
			in
				#"Changed Type"
