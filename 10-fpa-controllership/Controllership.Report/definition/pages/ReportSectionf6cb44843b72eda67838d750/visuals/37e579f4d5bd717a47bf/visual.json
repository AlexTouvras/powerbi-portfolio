                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0F1C24"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Signed Variance = VarianceEur x Account Sign so cost overruns read negative (hurt OP). Bars and heat use that sign.",
