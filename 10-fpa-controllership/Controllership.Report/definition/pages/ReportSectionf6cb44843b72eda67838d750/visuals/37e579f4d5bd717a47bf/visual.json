                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0F1C24"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Variance Drivers use Leaf Signed Variance (Level = 1) so statement totals are excluded from contribution bars.",
