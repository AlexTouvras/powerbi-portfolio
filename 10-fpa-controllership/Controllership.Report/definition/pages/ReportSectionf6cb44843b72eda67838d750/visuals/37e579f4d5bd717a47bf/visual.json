                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0F1C24"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "OP bridge: DimBridgeStep marks Budget OP and Actual OP with IsTotal. Category uses Budget + leaf steps; waterfall Show total draws Actual OP.",
