table DimBasketNetwork

	measure 'Basket bridge' =
			LOOKUPVALUE(DimBasketNetwork[Product], DimBasketNetwork[OrdersRank], 1)

	measure 'Basket cut points' =
			CONCATENATEX(
				FILTER(DimBasketNetwork, DimBasketNetwork[IsCutPointOrders] = 1),
				DimBasketNetwork[Product],
				", "
			)

	column Product
		dataType: string
		summarizeBy: none
		sourceColumn: Product
		sortByColumn: OrdersRank

	column OrdersBetweenness
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: OrdersBetweenness

	column OrdersRank
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: OrdersRank

	column IsCutPointOrders
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: IsCutPointOrders

	partition DimBasketNetwork = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(GoldDataFolder & "/DimBasketNetwork.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"Product", type text}, {"OrdersBetweenness", type number}, {"OrdersRank", Int64.Type}, {"IsCutPointOrders", Int64.Type}})
			in
				#"Changed Type"
