table ModelMetrics
	lineageTag: 75675a27-1981-4b39-94a3-730917254a07

	measure 'Fit Concordance' = MIN(ModelMetrics[Concordance])
		formatString: 0.00
		lineageTag: ca833d63-c723-4d10-a944-71c4bf9b2e83

	measure 'Log-rank p' = MIN(ModelMetrics[LogRankP])
		formatString: 0.00E+0
		lineageTag: f7874f94-2351-4431-8f7e-215054f4b265

	column N
		dataType: int64
		formatString: #,0
		lineageTag: d4a9f714-52a4-4fce-b31c-39fb19ff075e
		summarizeBy: none
		sourceColumn: N

	column Events
		dataType: int64
		formatString: #,0
		lineageTag: 28f6420c-f4eb-4be2-9a97-e56073f5a65a
		summarizeBy: none
		sourceColumn: Events

	column NCensored
		dataType: int64
		formatString: #,0
		lineageTag: 0fbbf72a-09c5-4599-8cf3-fe854bbb4d2c
		summarizeBy: none
		sourceColumn: NCensored

	column Concordance
		dataType: double
		formatString: 0.000
		lineageTag: 657dca30-8493-42a3-9a48-6ff47bd5ba6d
		summarizeBy: none
		sourceColumn: Concordance

	column LogRankP
		dataType: double
		formatString: 0.00E+0
		lineageTag: c9731dd1-3dd1-4d80-b948-066ea71046e8
		summarizeBy: none
		sourceColumn: LogRankP

	partition ModelMetrics = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(GoldDataFolder & "/ModelMetrics.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"N", Int64.Type}, {"Events", Int64.Type}, {"NCensored", Int64.Type}, {"Concordance", type number}, {"LogRankP", type number}})
				in
					#"Changed Type"

