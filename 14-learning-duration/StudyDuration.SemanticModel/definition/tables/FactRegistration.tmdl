table FactRegistration
	lineageTag: 8bd8e2ca-a108-49eb-9fbb-8b816d70c6f7

	measure Registrations = COUNTROWS(FactRegistration)
		formatString: #,0
		lineageTag: f93c4ddd-dc27-42a1-96f1-6fe97ec5407b

	measure Withdrawals = CALCULATE(COUNTROWS(FactRegistration), FactRegistration[Event] = 1)
		formatString: #,0
		lineageTag: 4c559230-1328-49a8-8d05-da860810dcca

	measure 'Withdrawal Rate' = DIVIDE([Withdrawals], [Registrations])
		formatString: 0.0%
		lineageTag: 7fce482b-d314-4568-80d2-418b6596926e

	column RegistrationId
		dataType: string
		lineageTag: ad37ae14-4ab9-4106-a7ea-58a6c9192d55
