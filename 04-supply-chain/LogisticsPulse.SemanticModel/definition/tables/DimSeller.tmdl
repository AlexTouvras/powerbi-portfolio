table DimSeller
	lineageTag: 211fa9b3-6e78-41b5-b56b-90560c81f98f

	measure Sellers = COUNTROWS(DimSeller)
		formatString: #,0
		lineageTag: 6471e943-731b-4a8b-a49d-4e1c43c689c7

	measure 'High Risk Sellers' = CALCULATE([Sellers], DimSeller[RiskBand] = "High")
		formatString: #,0
		lineageTag: e7722f70-1ff1-46c8-b8c4-68cdcbf27b68

	measure 'Seller Order N' = SUM(DimSeller[OrderN])
		formatString: #,0
		lineageTag: 00c9d3fa-94d8-4fdd-8b24-7da1cd8843b5

	measure 'Seller Late Rate' = AVERAGE(DimSeller[LateRate])
		formatString: 0.0%
		lineageTag: 1c4b1f31-1e62-4bd6-b418-0d444e2561a7

	measure 'Seller Avg Freight' = AVERAGE(DimSeller[AvgFreight])
		formatString: #,0.00
		lineageTag: b3e56d6e-e975-4df3-8ddb-7f05299d2a97

	column SellerID
		dataType: string
