table DimLaneNetwork

	measure 'Cut point' =
			CONCATENATEX(
				FILTER(DimLaneNetwork, DimLaneNetwork[IsCutPointLate] = 1),
				DimLaneNetwork[State],
				", "
			)

	measure 'Second bridge by late orders' =
			LOOKUPVALUE(DimLaneNetwork[State], DimLaneNetwork[LateRank], 2)

	measure 'Second bridge by orders' =
			LOOKUPVALUE(DimLaneNetwork[State], DimLaneNetwork[OrderRank], 2)

	column State
		dataType: string
		summarizeBy: none
		sourceColumn: State
		sortByColumn: LateRank

	column StateName
		dataType: string
		summarizeBy: none
		sourceColumn: StateName

	column LateBetweenness
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: LateBetweenness

	column OrderBetweenness
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: OrderBetweenness

	column LateRank
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: LateRank

	column OrderRank
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: OrderRank

	column IsCutPointLate
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: IsCutPointLate

	column IsCutPointOrder
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: IsCutPointOrder

	partition DimLaneNetwork = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(GoldDataFolder & "/DimLaneNetwork.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"State", type text}, {"StateName", type text}, {"LateBetweenness", type number}, {"OrderBetweenness", type number}, {"LateRank", Int64.Type}, {"OrderRank", Int64.Type}, {"IsCutPointLate", Int64.Type}, {"IsCutPointOrder", Int64.Type}})
			in
				#"Changed Type"
