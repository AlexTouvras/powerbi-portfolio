table FactOrders
	lineageTag: 1e1a45ed-e34b-4654-a26c-d43300349553

	measure Orders = COUNTROWS(FactOrders)
		formatString: #,0
		lineageTag: aab7fd63-bb05-43ae-8f9f-b51d70ee0e2f

	measure 'OnTime Orders' = CALCULATE([Orders], FactOrders[OnTime] = 1)
		formatString: #,0
		lineageTag: ff5b40b1-4470-49ae-989e-b607e6a2843b

	measure 'On-time %' = DIVIDE([OnTime Orders], [Orders])
		formatString: 0.0%
		lineageTag: 344b5f6a-9c53-4b67-be9f-f521b6526554

	measure 'Late Orders' = CALCULATE([Orders], FactOrders[LateFlag] = 1)
		formatString: #,0
		lineageTag: 78702de2-84c8-4d38-87c1-475e42c2eb6b

	measure 'Avg Lead Time' = AVERAGE(FactOrders[LeadTimeDays])
		formatString: #,0.0
		lineageTag: 6548fae5-6f57-4347-b400-5575cdd6dbd8

	measure 'Avg Freight' = AVERAGE(FactOrders[Freight])
		formatString: #,0.00
		lineageTag: be0a4a79-0504-4578-ac17-8df1f9490834

	measure 'Orders Stem' = [Orders]
		formatString: #,0
		lineageTag: 8f1a2b3c-4d5e-6f70-8192-a3b4c5d6e7f8

	measure 'Orders Dot' = [Orders]
		formatString: #,0
		lineageTag: 9a2b3c4d-5e6f-7081-92a3-b4c5d6e7f809

	column OrderID
