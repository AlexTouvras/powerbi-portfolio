{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Kaplan-Meier step curves. Bind FactKm: Stratum, Time, Survival, Lo, Hi, NRisk.",
  "data": { "name": "dataset" },
  "padding": 2,
  "height": 200,
  "width": "container",
  "encoding": {
    "x": {
      "field": "Time",
      "type": "quantitative",
      "title": "Days from module start",
      "axis": {
        "labelColor": "#5A6B75",
        "titleColor": "#5A6B75",
        "grid": false,
        "tickCount": 6,
        "titleFontSize": 10,
        "labelFontSize": 9,
        "titlePadding": 4
      }
    },
    "color": {
      "field": "Stratum",
      "type": "nominal",
      "legend": {
        "title": null,
        "labelColor": "#5A6B75",
        "orient": "top",
        "direction": "horizontal",
        "symbolType": "stroke",
        "labelFontSize": 11,
        "symbolSize": 80,
        "columns": 7,
        "padding": 2
      },
      "scale": {
        "domain": ["AAA", "BBB", "CCC", "DDD", "EEE", "FFF", "GGG"],
        "range": ["#2F5F73", "#5B8FA3", "#B42318", "#C17B3A", "#4A6B5C", "#8B6B4A", "#6B7C86"]
      }
    }
  },
  "layer": [
    {
      "mark": { "type": "area", "opacity": 0.18, "line": false },
      "encoding": {
        "y": {
          "field": "Lo",
          "type": "quantitative",
          "scale": { "domain": [0.55, 1], "zero": false },
          "axis": null
        },
        "y2": { "field": "Hi" }
      }
    },
    {
      "mark": { "type": "line", "interpolate": "step-after", "strokeWidth": 2.25 },
      "encoding": {
        "y": {
          "field": "Survival",
          "type": "quantitative",
          "title": null,
          "scale": { "domain": [0.55, 1], "zero": false },
          "axis": {
            "labelColor": "#5A6B75",
            "format": ".0%",
            "grid": true,
            "gridColor": "#E8EEF2",
            "tickCount": 5,
            "labelFontSize": 9
          }
        },
        "tooltip": [
          { "field": "Stratum", "type": "nominal" },
          { "field": "Time", "type": "quantitative", "format": ".0f", "title": "Day" },
          { "field": "Survival", "type": "quantitative", "format": ".1%" },
          { "field": "NRisk", "type": "quantitative", "title": "At risk", "format": ",.0f" }
        ]
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "background": "#FFFFFF"
  }
}
