{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "β(t) — container width (scales with FitToPage) + titles on top, no side labels.",
  "data": { "name": "dataset" },
  "padding": 2,
  "autosize": { "type": "fit", "contains": "padding" },
  "transform": [
    {
      "filter": {
        "field": "Term",
        "oneOf": ["StudiedCredits", "Disability", "Stratum[AAA]"]
      }
    }
  ],
  "vconcat": [
    {
      "transform": [{ "filter": { "field": "Term", "equal": "StudiedCredits" } }],
      "title": { "text": "StudiedCredits", "fontSize": 11, "color": "#5A6B75", "font": "Segoe UI Semibold", "anchor": "start", "offset": 2 },
      "width": "container",
      "height": 130,
      "layer": [
        {
          "transform": [{ "filter": { "field": "Kind", "equal": "residual" } }],
          "mark": { "type": "point", "filled": true, "size": 12, "opacity": 0.28, "color": "#8A9AA3" },
          "encoding": {
            "x": { "field": "Time", "type": "quantitative", "axis": null },
            "y": { "field": "Residual", "type": "quantitative", "axis": { "title": null, "labelFontSize": 8, "labelColor": "#5A6B75", "tickCount": 3, "grid": true, "gridColor": "#E8EEF2", "labelFlush": true, "labelOverlap": true } }
          }
        },
        {
          "transform": [{ "filter": { "field": "Kind", "equal": "smooth" } }],
          "mark": { "type": "area", "opacity": 0.16, "color": "#2F5F73" },
          "encoding": { "x": { "field": "Time", "type": "quantitative" }, "y": { "field": "Lo", "type": "quantitative" }, "y2": { "field": "Hi" } }
        },
        {
          "transform": [{ "filter": { "field": "Kind", "equal": "smooth" } }],
          "mark": { "type": "line", "strokeWidth": 1.75, "color": "#2F5F73" },
          "encoding": { "x": { "field": "Time", "type": "quantitative" }, "y": { "field": "Beta", "type": "quantitative" } }
        }
      ]
    },
    {
      "transform": [{ "filter": { "field": "Term", "equal": "Disability" } }],
      "title": { "text": "Disability", "fontSize": 11, "color": "#5A6B75", "font": "Segoe UI Semibold", "anchor": "start", "offset": 2 },
      "width": "container",
      "height": 130,
      "layer": [
        {
          "transform": [{ "filter": { "field": "Kind", "equal": "residual" } }],
          "mark": { "type": "point", "filled": true, "size": 12, "opacity": 0.28, "color": "#8A9AA3" },
          "encoding": {
            "x": { "field": "Time", "type": "quantitative", "axis": null },
            "y": { "field": "Residual", "type": "quantitative", "axis": { "title": null, "labelFontSize": 8, "labelColor": "#5A6B75", "tickCount": 3, "grid": true, "gridColor": "#E8EEF2", "labelFlush": true, "labelOverlap": true } }
          }
        },
        {
          "transform": [{ "filter": { "field": "Kind", "equal": "smooth" } }],
          "mark": { "type": "area", "opacity": 0.16, "color": "#2F5F73" },
          "encoding": { "x": { "field": "Time", "type": "quantitative" }, "y": { "field": "Lo", "type": "quantitative" }, "y2": { "field": "Hi" } }
        },
        {
          "transform": [{ "filter": { "field": "Kind", "equal": "smooth" } }],
          "mark": { "type": "line", "strokeWidth": 1.75, "color": "#2F5F73" },
          "encoding": { "x": { "field": "Time", "type": "quantitative" }, "y": { "field": "Beta", "type": "quantitative" } }
        }
      ]
    },
    {
      "transform": [{ "filter": { "field": "Term", "equal": "Stratum[AAA]" } }],
      "title": { "text": "Stratum[AAA]", "fontSize": 11, "color": "#5A6B75", "font": "Segoe UI Semibold", "anchor": "start", "offset": 2 },
      "width": "container",
      "height": 130,
      "layer": [
        {
          "transform": [{ "filter": { "field": "Kind", "equal": "residual" } }],
          "mark": { "type": "point", "filled": true, "size": 12, "opacity": 0.28, "color": "#8A9AA3" },
          "encoding": {
            "x": { "field": "Time", "type": "quantitative", "axis": { "title": null, "labelFontSize": 8, "labelColor": "#5A6B75", "tickCount": 5, "grid": false } },
            "y": { "field": "Residual", "type": "quantitative", "axis": { "title": null, "labelFontSize": 8, "labelColor": "#5A6B75", "tickCount": 3, "grid": true, "gridColor": "#E8EEF2", "labelFlush": true, "labelOverlap": true } }
          }
        },
        {
          "transform": [{ "filter": { "field": "Kind", "equal": "smooth" } }],
          "mark": { "type": "area", "opacity": 0.16, "color": "#2F5F73" },
          "encoding": { "x": { "field": "Time", "type": "quantitative" }, "y": { "field": "Lo", "type": "quantitative" }, "y2": { "field": "Hi" } }
        },
        {
          "transform": [{ "filter": { "field": "Kind", "equal": "smooth" } }],
          "mark": { "type": "line", "strokeWidth": 1.75, "color": "#2F5F73" },
          "encoding": {
            "x": { "field": "Time", "type": "quantitative" },
            "y": { "field": "Beta", "type": "quantitative" },
            "tooltip": [
              { "field": "Term", "type": "nominal" },
              { "field": "Time", "type": "quantitative", "format": ".0f" },
              { "field": "Beta", "type": "quantitative", "format": ".3f" }
            ]
          }
        }
      ]
    }
  ],
  "resolve": { "scale": { "x": "shared", "y": "independent" } },
  "config": {
    "view": { "stroke": null },
    "background": null,
    "concat": { "spacing": 8 }
  }
}
