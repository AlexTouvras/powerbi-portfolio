{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Single β(t) panel. Bind FactBetaT; filter Term in the visual or keep one term in the template placeholder.",
  "data": { "name": "dataset" },
  "padding": 4,
  "width": "container",
  "height": 118,
  "transform": [
    { "filter": { "field": "Term", "equal": "__TERM__" } }
  ],
  "layer": [
    {
      "transform": [{ "filter": { "field": "Kind", "equal": "residual" } }],
      "mark": { "type": "point", "filled": true, "size": 16, "opacity": 0.3, "color": "#8A9AA3" },
      "encoding": {
        "x": {
          "field": "Time",
          "type": "quantitative",
          "axis": { "title": null, "labelColor": "#5A6B75", "labelFontSize": 9, "grid": false, "tickCount": 5 }
        },
        "y": {
          "field": "Residual",
          "type": "quantitative",
          "axis": {
            "title": null,
            "labelColor": "#5A6B75",
            "labelFontSize": 9,
            "grid": true,
            "gridColor": "#E8EEF2",
            "tickCount": 3
          }
        }
      }
    },
    {
      "transform": [{ "filter": { "field": "Kind", "equal": "smooth" } }],
      "mark": { "type": "area", "opacity": 0.16, "color": "#2F5F73" },
      "encoding": {
        "x": { "field": "Time", "type": "quantitative" },
        "y": { "field": "Lo", "type": "quantitative" },
        "y2": { "field": "Hi" }
      }
    },
    {
      "transform": [{ "filter": { "field": "Kind", "equal": "smooth" } }],
      "mark": { "type": "line", "strokeWidth": 2, "color": "#2F5F73" },
      "encoding": {
        "x": { "field": "Time", "type": "quantitative" },
        "y": { "field": "Beta", "type": "quantitative" },
        "tooltip": [
          { "field": "Term", "type": "nominal" },
          { "field": "Time", "type": "quantitative", "format": ".0f" },
          { "field": "Beta", "type": "quantitative", "format": ".3f" }
        ]
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "background": null
  }
}
