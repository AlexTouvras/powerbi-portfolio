{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Single beta(t) panel. Bind FactBetaT. Smooth curve and interval only, so a large Schoenfeld residual cannot flatten the line.",
  "data": { "name": "dataset" },
  "padding": 4,
  "width": "container",
  "height": 118,
  "transform": [{ "filter": { "field": "Term", "equal": "__TERM__" } }],
  "layer": [
    {
      "transform": [{ "filter": { "field": "Kind", "equal": "smooth" } }],
      "mark": { "type": "area", "opacity": 0.18, "color": "#2F5F73" },
      "encoding": {
        "x": { "field": "Time", "type": "quantitative" },
        "y": { "field": "Lo", "type": "quantitative", "scale": { "zero": false }, "axis": null },
        "y2": { "field": "Hi" }
      }
    },
    {
      "transform": [{ "filter": { "field": "Kind", "equal": "smooth" } }],
      "mark": { "type": "line", "strokeWidth": 2, "color": "#2F5F73" },
      "encoding": {
        "x": {
          "field": "Time",
          "type": "quantitative",
          "axis": {
            "title": null,
            "labelColor": "#5A6B75",
            "labelFontSize": 9,
            "grid": false,
            "tickCount": 5
          }
        },
        "y": {
          "field": "Beta",
          "type": "quantitative",
          "scale": { "zero": false },
          "axis": {
            "title": null,
            "labelColor": "#5A6B75",
            "labelFontSize": 9,
            "grid": true,
            "gridColor": "#E8EEF2",
            "tickCount": 3
          }
        },
        "tooltip": [
          { "field": "Term", "type": "nominal" },
          { "field": "Time", "type": "quantitative", "format": ".0f" },
          { "field": "Beta", "type": "quantitative", "format": ".3f" }
        ]
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "background": "#FFFFFF"
  }
}
